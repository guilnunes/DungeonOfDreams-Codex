{
  "name": "dungeon-of-dreams-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "build": "npm run typecheck && vite build && npm run audit:public",
    "preview": "vite preview --host 127.0.0.1",
    "backend": "node --env-file-if-exists=backend/.env backend/server.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
